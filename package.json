{
  "name": "@1337exp/taoui",
  "version": "4.0.1",
  "description": "Design-token driven Vue 3 / Nuxt component library: one size scale, dark and light themes, built-in locales.",
  "keywords": [
    "vue",
    "vue3",
    "nuxt",
    "ui",
    "ui-library",
    "components",
    "component-library",
    "design-system",
    "design-tokens",
    "theming",
    "dark-mode",
    "typescript",
    "accessible",
    "color-picker",
    "slider",
    "toast"
  ],
  "homepage": "https://666.io",
  "bugs": {
    "url": "https://github.com/1337exp/taoui/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/1337exp/taoui.git"
  },
  "author": "1337exp",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./styles.css": "./dist/styles.css",
    "./styles/*": "./src/styles/*",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src/styles",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vite build",
    "dev": "vite build --watch",
    "type-check": "vue-tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "showcase": "npm --prefix showcase run dev",
    "showcase:build": "npm --prefix showcase run build",
    "media": "node scripts/media.mjs",
    "prepublishOnly": "npm run type-check && npm run test && npm run build"
  },
  "peerDependencies": {
    "nuxt": "^3.0.0",
    "vue": "^3.4.0"
  },
  "peerDependenciesMeta": {
    "nuxt": {
      "optional": true
    }
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.0.0",
    "@vue/test-utils": "^2.5.1",
    "happy-dom": "^15.11.7",
    "playwright-core": "^1.64.1",
    "typescript": "^5.3.0",
    "vite": "^5.0.0",
    "vite-plugin-dts": "^3.7.0",
    "vitest": "^2.1.9",
    "vue": "^3.4.0",
    "vue-tsc": "^2.0.0"
  }
}
