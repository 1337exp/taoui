{
  "name": "@1337exp/taoui",
  "version": "5.0.0",
  "description": "Design-token driven Vue 3 / Nuxt component library: one size scale, dark and light themes, built-in locales.",
  "keywords": [
    "vue",
    "vue3",
    "nuxt",
    "ui",
    "ui-library",
    "components",
    "component-library",
    "design-system",
    "design-tokens",
    "theming",
    "dark-mode",
    "typescript",
    "accessible",
    "color-picker",
    "slider",
    "toast"
  ],
  "homepage": "https://666.io",
  "bugs": {
    "url": "https://github.com/1337exp/taoui/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/1337exp/taoui.git"
  },
  "author": "1337exp",
  "license": "MIT",
  "type": "module",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css",
    "./palettes.css": "./src/styles/palettes/index.css",
    "./styles/*": "./src/styles/*",
    "./package.json": "./package.json"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist",
    "src/styles",
    "CHANGELOG.md",
    "MIGRATION-5.md"
  ],
  "browserslist": [
    "chrome >= 111",
    "edge >= 111",
    "safari >= 16.4",
    "firefox >= 128"
  ],
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vite build",
    "dev": "vite build --watch",
    "type-check": "vue-tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "showcase": "npm --prefix showcase run dev",
    "showcase:build": "npm --prefix showcase run build",
    "media": "node scripts/media.mjs",
    "smoke": "node scripts/consumer-smoke.mjs",
    "prepublishOnly": "npm run type-check && npm run test && npm run build && npm run lint:package",
    "lint:package": "publint && attw --pack . --profile esm-only --exclude-entrypoints styles.css palettes.css",
    "palettes": "node scripts/generate-palettes.mjs"
  },
  "peerDependencies": {
    "vue": "^3.4.0"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@types/node": "^20.19.43",
    "@vitejs/plugin-vue": "^5.0.0",
    "@vue/test-utils": "^2.5.1",
    "happy-dom": "^15.11.7",
    "playwright-core": "^1.64.1",
    "publint": "^0.3.25",
    "typescript": "^5.3.0",
    "vite": "^5.0.0",
    "vite-plugin-dts": "^3.7.0",
    "vitest": "^2.1.9",
    "vue": "^3.4.0",
    "vue-tsc": "^2.0.0"
  }
}
